     cuid_t cuid, const std::shared_ptr<Request>& req,
     const std::shared_ptr<FileEntry>& fileEntry, RequestGroup* requestGroup,
@@ -203,6 +233,9 @@ bool HttpSkipResponseCommand::processResponse()
 
   auto statusCode = httpResponse_->getStatusCode();
   if (statusCode >= 400) {
+    const auto retryWait =
+        std::chrono::seconds(getOption()->getAsInt(PREF_RETRY_WAIT));
+    bool retryOnStatus;
     switch (statusCode) {
     case 401: // Unauthorized
       if (getOption()->getAsBool(PREF_HTTP_AUTH_CHALLENGE) &&
@@ -221,25 +254,13 @@ bool HttpSkipResponseCommand::processResponse()
       throw DL_RETRY_EX2(MSG_RESOURCE_NOT_FOUND,
                          error_code::RESOURCE_NOT_FOUND);
     case 400: // Bad Request
-      if (getOption()->getAsBool(PREF_RETRY_ON_400)
-          && getOption()->getAsInt(PREF_RETRY_WAIT) > 0) {
-        throw DL_RETRY_EX2(fmt(EX_BAD_STATUS, statusCode),
-                          error_code::HTTP_PROTOCOL_ERROR);
-      }
+      retryOnStatus = getOption()->getAsBool(PREF_RETRY_ON_400);
       break;
     case 403: // Forbidden
-      if (getOption()->getAsBool(PREF_RETRY_ON_403)
-          && getOption()->getAsInt(PREF_RETRY_WAIT) > 0) {
-        throw DL_RETRY_EX2(fmt(EX_BAD_STATUS, statusCode),
-                          error_code::HTTP_PROTOCOL_ERROR);
-      }
+      retryOnStatus = getOption()->getAsBool(PREF_RETRY_ON_403);
       break;
     case 406: // Not Acceptable
-      if (getOption()->getAsBool(PREF_RETRY_ON_406)
-          && getOption()->getAsInt(PREF_RETRY_WAIT) > 0) {
-        throw DL_RETRY_EX2(fmt(EX_BAD_STATUS, statusCode),
-                          error_code::HTTP_PROTOCOL_ERROR);
-      }
+      retryOnStatus = getOption()->getAsBool(PREF_RETRY_ON_406);
       break;
     case 408: // Request Timeout
     case 429: // Too Many Requests
@@ -248,23 +269,28 @@ bool HttpSkipResponseCommand::processResponse()
     case 507: // Insufficient Storage
     case 520: // https://github.com/aria2/aria2/issues/1229
     case 521: // https://github.com/aria2/aria2/issues/1229
-      // Only retry if pretry-wait > 0. Hammering 'busy' server is not
-      // a good idea.
-      if (getOption()->getAsInt(PREF_RETRY_WAIT) > 0) {
-        throw DL_RETRY_EX2(fmt(EX_BAD_STATUS, statusCode),
-                           error_code::HTTP_SERVICE_UNAVAILABLE);
+      if (retryWait > std::chrono::seconds::zero()) {
+        auto delay = retryWait;
+        if (statusCode == 429 || statusCode == 503) {
+          const auto& header = *httpResponse_->getHttpHeader();
+          delay = std::max(delay,
+                           retryAfterDelay(header.find(HttpHeader::RETRY_AFTER)));
+        }
+        throw DlRetryEx(__FILE__, __LINE__, fmt(EX_BAD_STATUS, statusCode),
+                        error_code::HTTP_SERVICE_UNAVAILABLE, delay);
       }
       throw DL_ABORT_EX2(fmt(EX_BAD_STATUS, statusCode),
                          error_code::HTTP_SERVICE_UNAVAILABLE);
     case 504: // Gateway Timeout
-      // This is Gateway Timeout, so try again
-      throw DL_RETRY_EX2(fmt(EX_BAD_STATUS, statusCode),
-                         error_code::HTTP_SERVICE_UNAVAILABLE);
-    };
-    if (getOption()->getAsBool(PREF_RETRY_ON_UNKNOWN)
-        && getOption()->getAsInt(PREF_RETRY_WAIT) > 0) {
-      throw DL_RETRY_EX2(fmt(EX_BAD_STATUS, statusCode),
-                        error_code::HTTP_PROTOCOL_ERROR);
+      throw DlRetryEx(__FILE__, __LINE__, fmt(EX_BAD_STATUS, statusCode),
+                      error_code::HTTP_SERVICE_UNAVAILABLE, retryWait);
+    default:
+      retryOnStatus = getOption()->getAsBool(PREF_RETRY_ON_UNKNOWN);
+      break;
+    }
+    if (retryOnStatus && retryWait > std::chrono::seconds::zero()) {
+      throw DlRetryEx(__FILE__, __LINE__, fmt(EX_BAD_STATUS, statusCode),
+                      error_code::HTTP_PROTOCOL_ERROR, retryWait);
     }
     throw DL_ABORT_EX2(fmt(EX_BAD_STATUS, statusCode),
                        error_code::HTTP_PROTOCOL_ERROR);
