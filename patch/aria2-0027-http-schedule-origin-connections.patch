+bool ConnectCommand::switchToBackupAddress()
+{
+  auto& request = *getRequest();
+  auto* engine = getDownloadEngine();
+  if (engine->getRequestGroupMan()->isHttpHostCoolingDown(request)) {
+    return prepareForRetry(1);
+  }
+
+  auto addr = backupConnectionInfo_->ipaddr;
+  backupConnectionInfo_.reset();
+  primaryAddr_ = request.getConnectedAddr();
+  const auto port = request.getConnectedPort();
+
+  // Reuse the primary connection's slot. Close its socket before connecting
+  // to IPv4 and keep its address eligible if IPv4 also fails.
+  disableWriteCheckSocket();
+  getSocket()->closeConnection();
+  request.setConnectedAddrInfo(request.getConnectedHostname(), addr, port);
+  A2_LOG_INFO(fmt(MSG_CONNECTING_TO_SERVER, getCuid(), addr.c_str(), port));
+  try {
+    getSocket()->establishConnection(addr, port);
+  }
+  catch (RecoverableException&) {
+    if (tryNextConnectionAddress()) {
+      return true;
+    }
+    throw;
+  }
+  setWriteCheckSocket(getSocket());
+  addCommandSelf();
+  return false;
+}
+
+bool ConnectCommand::tryNextAddressOnTimeout()
+{
+  return !primaryAddr_.empty() && tryNextConnectionAddress();
+}
