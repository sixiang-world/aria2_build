+void RequestGroupManTest::testHttpHostCooldown()
+{
+  Request first, second, other, ftp;
+  CPPUNIT_ASSERT(first.setUri("http://example.test/first"));
+  CPPUNIT_ASSERT(second.setUri("https://EXAMPLE.test.:8443/second"));
+  CPPUNIT_ASSERT(other.setUri("http://other.test/third"));
+  CPPUNIT_ASSERT(ftp.setUri("ftp://example.test/fourth"));
+
+  const auto now = global::wallclock();
+  rgman_->coolDownHttpHost(first, 8_s);
+  rgman_->coolDownHttpHost(second, 2_s);
+  rgman_->coolDownHttpHost(other, 0_s);
+  global::wallclock().advance(4_s);
+  const bool sameHostIsBlocked = rgman_->isHttpHostCoolingDown(second);
+  const bool otherHostIsAvailable = rgman_->isHttpOriginAvailable(other);
+  const bool ftpIsAvailable = rgman_->isHttpOriginAvailable(ftp);
+  global::wallclock().advance(4_s);
+  const bool cooledHostIsAvailable = rgman_->isHttpOriginAvailable(first);
+  global::wallclock() = now;
+
+  CPPUNIT_ASSERT(sameHostIsBlocked);
+  CPPUNIT_ASSERT(otherHostIsAvailable);
+  CPPUNIT_ASSERT(ftpIsAvailable);
+  CPPUNIT_ASSERT(cooledHostIsAvailable);
+}
