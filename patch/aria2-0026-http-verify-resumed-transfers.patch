+void RequestGroup::saveHttpResumeInfo(HttpResumeInfo info)
+{
+  auto progress = std::dynamic_pointer_cast<DefaultBtProgressInfoFile>(
+      progressInfoFile_);
+  if (!progress) {
+    return;
+  }
+
+  try {
+    pieceStorage_->flushWrDiskCacheEntry(false);
+    pieceStorage_->getDiskAdaptor()->flushOSBuffers();
+    progress->save(info);
+  }
+  catch (RecoverableException& ex) {
+    throw DOWNLOAD_FAILURE_EXCEPTION2(EX_DOWNLOAD_ABORTED, ex);
+  }
+  downloadContext_->setHttpResumeInfo(std::move(info));
+}
+
+void RequestGroup::writeHttpResumeReset(int64_t totalLength)
+{
+  auto resetContext = std::make_shared<DownloadContext>(
+      downloadContext_->getPieceLength(), totalLength,
+      downloadContext_->getBasePath());
+  auto emptyStorage =
+      std::make_shared<DefaultPieceStorage>(resetContext, option_.get());
+  DefaultBtProgressInfoFile progress(resetContext, emptyStorage, option_.get());
+  try {
+    progress.save();
+  }
+  catch (RecoverableException& ex) {
+    throw DOWNLOAD_FAILURE_EXCEPTION2(EX_DOWNLOAD_ABORTED, ex);
+  }
+}
+
+void RequestGroup::restartHttpDownload(int64_t totalLength)
+{
+  if (httpRestarted_) {
+    throw DOWNLOAD_FAILURE_EXCEPTION2("HTTP range rejected after restarting",
+                                      error_code::CANNOT_RESUME);
+  }
+  writeHttpResumeReset(totalLength);
+
+  // Discard all old commands before opening the cleared progress again.
+  // The old storage must not overwrite the newly saved control file.
+  disableSaveControlFile();
+  httpRestarted_ = true;
+  httpRestartPending_ = true;
+  numConcurrentCommand_ = 1;
+
+  setHaltRequested(true);
+  setPauseRequested(true);
+  setRestartRequested(true);
+}
