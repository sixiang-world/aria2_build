From f0849dfdb6092c72481f16c3e1e537e13eeb9958 Mon Sep 17 00:00:00 2001
From: aria2_build contributors <aria2-build@users.noreply.github.com>
Date: Wed, 18 Nov 2026 23:09:18 +0800
Subject: [PATCH] bittorrent: add opt-in sequential peer piece selection
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Inspired by sleepymac’s aria2 PR #1671. Reuse the existing bitfield selection helper, install the selector only for BitTorrent request groups, and retain the existing priority wrapper and default behavior.

Reference: https://github.com/aria2/aria2/pull/1671
---
 doc/manual-src/en/aria2c.rst | 11 +++++++++++
 src/DefaultPieceStorage.cc   |  6 ++++--
 src/OptionHandlerFactory.cc  | 10 ++++++++++
 src/RequestGroup.cc          | 19 ++++++++++++++++++-
 src/prefs.cc                 |  2 ++
 src/prefs.h                  |  2 ++
 src/usage_text.h             |  4 ++++
 7 files changed, 51 insertions(+), 3 deletions(-)

diff --git a/doc/manual-src/en/aria2c.rst b/doc/manual-src/en/aria2c.rst
index 6d54f36..81e0a89 100644
--- a/doc/manual-src/en/aria2c.rst
+++ b/doc/manual-src/en/aria2c.rst
@@ -757,6 +757,16 @@ BitTorrent Specific Options
   one which satisfies the given level.
   Default: ``plain``
 
+.. option:: --bt-piece-selector=default|inorder
+
+  Choose how pieces are requested from BitTorrent peers. `default`
+  retains the usual selection policy. `inorder` prefers the earliest
+  available pieces, which is useful when reading a file while it downloads.
+  Peer availability and parallel requests can lead to out-of-order
+  completion. :option:`--bt-prioritize-piece` still takes precedence
+  before endgame. This option does not change HTTP/FTP piece selection.
+  Default: ``default``
+
 .. option:: --bt-prioritize-piece=head[=<SIZE>],tail[=<SIZE>]
 
   Try to download first and last pieces of each file first. This is
@@ -2136,6 +2146,7 @@ of URIs. These optional lines must start with white space(s).
   * :option:`bt-max-peers <--bt-max-peers>`
   * :option:`bt-metadata-only <--bt-metadata-only>`
   * :option:`bt-min-crypto-level <--bt-min-crypto-level>`
+  * :option:`bt-piece-selector <--bt-piece-selector>`
   * :option:`bt-prioritize-piece <--bt-prioritize-piece>`
   * :option:`bt-remove-unselected-file <--bt-remove-unselected-file>`
   * :option:`bt-request-peer-speed-limit <--bt-request-peer-speed-limit>`
diff --git a/src/DefaultPieceStorage.cc b/src/DefaultPieceStorage.cc
index e08b1b1..1f66a93 100644
--- a/src/DefaultPieceStorage.cc
+++ b/src/DefaultPieceStorage.cc
@@ -212,8 +212,10 @@ void DefaultPieceStorage::getMissingPiece(
         indexes.push_back(i);
       }
     }
-    std::shuffle(indexes.begin(), indexes.end(),
-                 *SimpleRandomizer::getInstance());
+    if (option_->get(PREF_BT_PIECE_SELECTOR) != V_INORDER) {
+      std::shuffle(indexes.begin(), indexes.end(),
+                   *SimpleRandomizer::getInstance());
+    }
     for (std::vector<size_t>::const_iterator i = indexes.begin(),
                                              eoi = indexes.end();
          i != eoi && misBlock < minMissingBlocks; ++i) {
diff --git a/src/OptionHandlerFactory.cc b/src/OptionHandlerFactory.cc
index 94b8dc8..69794bb 100644
--- a/src/OptionHandlerFactory.cc
+++ b/src/OptionHandlerFactory.cc
@@ -1629,6 +1629,16 @@ std::vector<OptionHandler*> OptionHandlerFactory::createOptionHandlers()
     op->setChangeOptionForReserved(true);
     handlers.push_back(op);
   }
+  {
+    OptionHandler* op(new ParameterOptionHandler(
+        PREF_BT_PIECE_SELECTOR, TEXT_BT_PIECE_SELECTOR, A2_V_DEFAULT,
+        {A2_V_DEFAULT, V_INORDER}));
+    op->addTag(TAG_BITTORRENT);
+    op->setInitialOption(true);
+    op->setChangeGlobalOption(true);
+    op->setChangeOptionForReserved(true);
+    handlers.push_back(op);
+  }
   {
     OptionHandler* op(new PrioritizePieceOptionHandler(
         PREF_BT_PRIORITIZE_PIECE, TEXT_BT_PRIORITIZE_PIECE));
diff --git a/src/RequestGroup.cc b/src/RequestGroup.cc
index fd6801f..185b077 100644
--- a/src/RequestGroup.cc
+++ b/src/RequestGroup.cc
@@ -110,6 +110,7 @@
 #  include "DHTPeerAnnounceStorage.h"
