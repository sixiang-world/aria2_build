+void FileEntryTest::testFindFasterRequestSkipsSleepingRequest()
+{
+  FileEntry fileEntry("aria2.zip", 1024, 0, {});
+  auto base = std::make_shared<Request>();
+  auto sleeping = std::make_shared<Request>();
+  CPPUNIT_ASSERT(sleeping->setUri("http://localhost/aria2.zip"));
+  sleeping->initPeerStat();
+  auto wakeTime = global::wallclock();
+  wakeTime.advance(60_s);
+  sleeping->setWakeTime(wakeTime);
+  fileEntry.poolRequest(sleeping);
+  CPPUNIT_ASSERT(!fileEntry.findFasterRequest(base));
+
+  auto ready = std::make_shared<Request>();
+  CPPUNIT_ASSERT(ready->setUri("http://mirror/aria2.zip"));
+  ready->initPeerStat();
+  fileEntry.poolRequest(ready);
+  CPPUNIT_ASSERT(fileEntry.findFasterRequest(base) == ready);
+}
