From db3785680daed595256bd3d1cdf41b5487bbdd7f Mon Sep 17 00:00:00 2001
From: Dr_rOot <agalwood.net@gmail.com>
Date: Wed, 18 Nov 2026 23:12:08 +0800
Subject: [PATCH] fix(net): try alternate addresses after socket exceptions

Backport the event handling portion of Motrix aria2 commit 5f6f001d1fd7c9f8abd6b3bd15ece18cc3629a3b. Treat a Winsock exceptfds notification as a connection-completion event so the socket error marks the failed address and tries a cached alternative. Handle the same event in the backup IPv4 connection and enforce its timeout whenever the backup socket exists.

Keep upstream error codes and adapt the loopback regression test for the affected path.
---
 src/BackupIPv4ConnectCommand.cc | 14 +++----
 src/ConnectCommand.cc           |  5 ++-
 test/AbstractCommandTest.cc     | 69 ++++++++++++++++++++++++++++++++-
 3 files changed, 79 insertions(+), 9 deletions(-)

diff --git a/src/BackupIPv4ConnectCommand.cc b/src/BackupIPv4ConnectCommand.cc
index 61ef9e28..ba851c87 100644
--- a/src/BackupIPv4ConnectCommand.cc
+++ b/src/BackupIPv4ConnectCommand.cc
@@ -87,7 +87,7 @@ bool BackupIPv4ConnectCommand::execute()
     retval = true;
   }
   else if (socket_) {
-    if (writeEventEnabled()) {
+    if (writeEventEnabled() || errorEventEnabled()) {
       try {
         std::string error = socket_->getSocketError();
         if (error.empty()) {
@@ -113,8 +113,13 @@ bool BackupIPv4ConnectCommand::execute()
         retval = true;
       }
     }
+    else if (timeoutCheck_.difference(global::wallclock()) >= timeout_) {
+      A2_LOG_INFO(
+          fmt("CUID#%" PRId64 " - Backup connection command timeout", getCuid()));
+      retval = true;
+    }
   }
-  else if (!socket_) {
+  else {
     // TODO Although we check 300ms initial timeout as described in
     // RFC 6555, the interval will be much longer and around 1 second
     // due to the refresh interval mechanism in DownloadEngine.
@@ -134,11 +139,6 @@ bool BackupIPv4ConnectCommand::execute()
       }
     }
   }
-  else if (timeoutCheck_.difference(global::wallclock()) >= timeout_) {
-    A2_LOG_INFO(
-        fmt("CUID#%" PRId64 " - Backup connection command timeout", getCuid()));
-    retval = true;
-  }
   if (!retval) {
     e_->addCommand(std::unique_ptr<Command>(this));
   }
diff --git a/src/ConnectCommand.cc b/src/ConnectCommand.cc
index 5d1566be..54307305 100644
--- a/src/ConnectCommand.cc
+++ b/src/ConnectCommand.cc
@@ -114,7 +114,10 @@ bool ConnectCommand::executeInternal()
 
 bool ConnectCommand::noCheck() const
 {
-  return backupConnectionInfo_ && !backupConnectionInfo_->ipaddr.empty();
+  // Winsock reports a failed nonblocking connect in exceptfds rather than
+  // writefds. Read SO_ERROR through the same address failover path.
+  return errorEventEnabled() ||
+         (backupConnectionInfo_ && !backupConnectionInfo_->ipaddr.empty());
 }
 
 } // namespace aria2
