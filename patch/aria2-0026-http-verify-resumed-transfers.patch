+HttpResumeInfo HttpResponse::getHttpResumeInfo() const
+{
+  const auto& etag = httpHeader_->find(HttpHeader::ETAG);
+  if (HttpResumeInfo::isStrongETag(etag) &&
+      httpHeader_->findAll(HttpHeader::ETAG).size() == 1) {
+    return {httpRequest_->getHttpResumeResource(), etag};
+  }
+
+  // A date is a strong validator only when no entity-tag was provided
+  // and the response Date is at least one minute newer (RFC 9110).
+  if (httpHeader_->defined(HttpHeader::ETAG)) {
+    return {};
+  }
+
+  const auto lastModified = getLastModifiedTime();
+  const auto date = Time::parseHTTPDate(httpHeader_->find(HttpHeader::DATE));
+  if (lastModified.good() && date.good() &&
+      std::difftime(date.getTimeFromEpoch(), lastModified.getTimeFromEpoch()) >=
+          60 &&
+      httpHeader_->findAll(HttpHeader::LAST_MODIFIED).size() == 1 &&
+      httpHeader_->findAll(HttpHeader::DATE).size() == 1) {
+    return {httpRequest_->getHttpResumeResource(), lastModified.toHTTPDate()};
+  }
+  return {};
+}
+
+bool HttpResponse::rejectsHttpResume() const
+{
+  const auto& validator = httpRequest_->getSentIfRangeValidator();
+  if (validator.empty()) {
+    return false;
+  }
+
+  if (getStatusCode() == 200) {
+    return true;
+  }
+  if (getStatusCode() != 206) {
+    return false;
+  }
+
+  // The 206 itself confirms a matching If-Range on conforming servers.
+  // Some servers ignore If-Range. Reject an explicitly different validator
+  // of the same type before accepting body data.
+  if (HttpResumeInfo::isStrongETag(validator)) {
+    const auto& etag = httpHeader_->find(HttpHeader::ETAG);
+    if (HttpResumeInfo::isStrongETag(etag)) {
+      return etag != validator;
+    }
+    return util::startsWith(etag, "W/") &&
+           HttpResumeInfo::isStrongETag(etag.substr(2)) &&
+           etag.compare(2, std::string::npos, validator) != 0;
+  }
+
+  const auto lastModified = getLastModifiedTime();
+  return lastModified.good() && lastModified.toHTTPDate() != validator;
+}
