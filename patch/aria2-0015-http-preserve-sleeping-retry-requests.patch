   CPPUNIT_TEST(testFindFasterRequestSkipsSleepingRequest);
   CPPUNIT_TEST(testReuseUri);
   CPPUNIT_TEST(testAddUri);
@@ -35,6 +37,8 @@ public:
   void testGetRequest_withoutUriReuse();
   void testGetRequest_withUniqueProtocol();
   void testGetRequest_withReferer();
+  void testGetRequest_wakeDelayDoesNotCreateInFlightDuplicate();
+  void testGetRequest_wakeDelayAppliesToMatchingRequest();
   void testFindFasterRequestSkipsSleepingRequest();
   void testReuseUri();
   void testAddUri();
@@ -187,6 +191,51 @@ void FileEntryTest::testGetRequest_withReferer()
   CPPUNIT_ASSERT_EQUAL(req->getUri(), req->getReferer());
 }
 
+void FileEntryTest::testGetRequest_wakeDelayDoesNotCreateInFlightDuplicate()
+{
+  FileEntry fileEntry("aria2.zip", 1024, 0, {"http://localhost/aria2.zip"});
+  fileEntry.setMaxConnectionPerServer(2);
+  InorderURISelector selector;
+  std::vector<std::pair<size_t, std::string>> usedHosts;
+  auto request = fileEntry.getRequest(&selector, true, usedHosts);
+  auto wakeTime = global::wallclock();
+  wakeTime.advance(60_s);
+  request->setWakeTime(wakeTime);
+  fileEntry.poolRequest(request);
+
+  auto retry = fileEntry.getRequest(&selector, true, usedHosts);
+  CPPUNIT_ASSERT(retry == request);
+  CPPUNIT_ASSERT_EQUAL(size_t{1}, fileEntry.countInFlightRequest());
+  CPPUNIT_ASSERT_EQUAL(size_t{1}, fileEntry.getSpentUris().size());
+  fileEntry.poolRequest(retry);
+  CPPUNIT_ASSERT_EQUAL(size_t{0}, fileEntry.countInFlightRequest());
+}
+
+void FileEntryTest::testGetRequest_wakeDelayAppliesToMatchingRequest()
+{
+  FileEntry fileEntry("aria2.zip", 1024, 0,
+                     {"http://localhost/z", "http://localhost/a"});
+  fileEntry.setMaxConnectionPerServer(3);
+  InorderURISelector selector;
+  std::vector<std::pair<size_t, std::string>> usedHosts;
+  auto wakeTime = global::wallclock();
+  wakeTime.advance(60_s);
+  auto first = fileEntry.getRequest(&selector, true, usedHosts);
+  auto second = fileEntry.getRequest(&selector, true, usedHosts);
+  first->initPeerStat();
+  first->setWakeTime(wakeTime);
+  second->setWakeTime(wakeTime);
+  fileEntry.poolRequest(first);
+  fileEntry.poolRequest(second);
+  CPPUNIT_ASSERT_EQUAL(size_t{2}, fileEntry.countPooledRequest());
+
+  // Reused URIs are sorted, so the second pooled request matches first.
+  auto retry = fileEntry.getRequest(&selector, true, usedHosts);
+  CPPUNIT_ASSERT(retry == second);
+  CPPUNIT_ASSERT(retry->getWakeTime().getTime() == wakeTime.getTime());
+  CPPUNIT_ASSERT_EQUAL(size_t{1}, fileEntry.countPooledRequest());
+}
+
 void FileEntryTest::testFindFasterRequestSkipsSleepingRequest()
 {
   FileEntry fileEntry("aria2.zip", 1024, 0, {});
