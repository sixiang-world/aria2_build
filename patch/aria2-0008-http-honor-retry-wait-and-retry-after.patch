 #include "HttpConnection.h"
 #include "HttpResponse.h"
 #include "message.h"
@@ -60,9 +64,35 @@
 #include "SinkStreamFilter.h"
 #include "error_code.h"
 #include "SocketRecvBuffer.h"
+#include "TimeA2.h"
 
 namespace aria2 {
 
+namespace {
+std::chrono::seconds retryAfterDelay(const std::string& value)
+{
+  constexpr int maxDelay = 600;
+  if (value.empty()) {
+    return {};
+  }
+  if (std::all_of(value.begin(), value.end(), util::isDigit)) {
+    int delay = 0;
+    for (const auto digit : value) {
+      delay = std::min(maxDelay, delay * 10 + (digit - '0'));
+    }
+    return std::chrono::seconds(delay);
+  }
+
+  const auto date = Time::parseHTTPDate(value);
+  if (!date.good()) {
+    return {};
+  }
+  const auto delay = std::difftime(date.getTimeFromEpoch(), std::time(nullptr));
+  return std::chrono::seconds(static_cast<int>(
+      std::max(0.0, std::min(delay, static_cast<double>(maxDelay)))));
+}
+} // namespace
