+bool HttpResumeInfo::isStrongETag(const std::string& value)
+{
+  return value.size() >= 2 && value.size() <= MAX_VALIDATOR_LENGTH &&
+         value.front() == '"' && value.back() == '"' &&
+         std::all_of(value.begin() + 1, value.end() - 1,
+                     [](unsigned char c) {
+                       return c == 0x21 || (c >= 0x23 && c <= 0x7e) ||
+                              c >= 0x80;
+                     });
+}
+
+bool HttpResumeInfo::valid() const
+{
+  if (resource.size() != RESOURCE_LENGTH) {
+    return false;
+  }
+
+  if (isStrongETag(validator)) {
+    return true;
+  }
+
+  if (validator.size() != 29) {
+    return false;
+  }
+
+  const auto time = Time::parseHTTPDate(validator);
+  return time.good() && time.toHTTPDate() == validator;
+}
