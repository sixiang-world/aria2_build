+void RequestGroupManTest::testHttpOriginMirrorSelection()
+{
+  option_->put(PREF_MAX_OVERALL_CONNECTION_PER_ORIGIN, "1");
+  RequestGroupMan manager({}, 3, option_.get());
+  HttpOriginTestCommand one(1);
+  const std::string firstUri = "http://example.test/first";
+  const std::string secondUri = "http://other.test/second";
+  Request request;
+  CPPUNIT_ASSERT(request.setUri(firstUri));
+  auto active = manager.queueHttpConnection(request, 1, &one, e_.get());
+  CPPUNIT_ASSERT(active->tryAcquire());
+
+  FileEntry entry("file", 1024, 0, {firstUri, secondUri});
+  InorderURISelector selector;
+  auto next = entry.getRequest(&selector, true, {}, "", Request::METHOD_GET,
+                               &manager);
+  CPPUNIT_ASSERT(next);
+  CPPUNIT_ASSERT_EQUAL(secondUri, next->getUri());
+  manager.coolDownHttpHost(*next, 2_s);
+  entry.poolRequest(next);
+  active.reset();
+  next = entry.getRequest(&selector, true, {}, "", Request::METHOD_GET, &manager);
+  CPPUNIT_ASSERT(next);
+  CPPUNIT_ASSERT_EQUAL(firstUri, next->getUri());
+}
