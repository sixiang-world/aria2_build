+void AbstractCommandTest::testIpv4BackupReusesSaturatedOriginSlot()
+{
+  auto option = std::make_shared<Option>();
+  OptionParser::getInstance()->parseDefaultValues(*option);
+  option->put(PREF_MAX_TRIES, "1");
+  option->put(PREF_MAX_OVERALL_CONNECTION_PER_ORIGIN, "1");
+  const std::string uri = "http://connect.test/file";
+  auto group = createRequestGroup(1024, 0, "file", uri, option);
+  DownloadEngine engine(make_unique<SelectEventPoll>());
+  engine.setOption(option.get());
+  engine.setRequestGroupMan(make_unique<RequestGroupMan>(
+      std::vector<std::shared_ptr<RequestGroup>>{group}, 1, option.get()));
+
+  SocketCore listener;
+  listener.bind("127.0.0.1", 0, AF_INET);
+  listener.beginListen();
+  const auto port = listener.getAddrInfo().port;
+  auto socket = std::make_shared<SocketCore>();
+  socket->establishConnection("127.0.0.1", port);
+  CPPUNIT_ASSERT(listener.isReadable(5));
+  auto oldPeer = listener.acceptConnection();
+
+  auto request = std::make_shared<Request>();
+  CPPUNIT_ASSERT(request->setUri(uri));
+  request->setConnectedAddrInfo("connect.test", "::1", port);
+  auto& manager = *engine.getRequestGroupMan();
+  auto connection = manager.queueHttpConnection(*request, group->getGID(),
+                                                nullptr, &engine);
+  CPPUNIT_ASSERT(connection->tryAcquire());
+  request->setHttpOriginConnection(connection);
+  auto command = make_unique<ConnectCommand>(
+      1, request, nullptr, group->getDownloadContext()->getFirstFileEntry(),
+      group.get(), &engine, socket);
+  connection.reset();
+  auto info = std::make_shared<BackupConnectInfo>();
+  command->setBackupConnectInfo(info);
+  auto backup = make_unique<BackupIPv4ConnectCommand>(
+      2, "127.0.0.1", port, request, info, command.get(), group.get(), &engine);
+
+  // Withhold the primary's write event to model a pending connection.
+  const auto now = global::wallclock();
+  global::wallclock().advance(1_s);
+  const bool backupDone = backup->execute();
+  global::wallclock() = now;
+  if (!backupDone) {
+    backup.release(); // execute() requeues unfinished commands.
+  }
+  CPPUNIT_ASSERT(backupDone);
+  CPPUNIT_ASSERT(!info->socket);
+  const bool done = command->execute();
+  if (!done) {
+    command.release();
+  }
+  CPPUNIT_ASSERT(!done);
+  CPPUNIT_ASSERT(listener.isReadable(5));
+  CPPUNIT_ASSERT(oldPeer->isReadable(5));
+  char byte;
+  size_t length = 1;
+  oldPeer->readData(&byte, length);
+  CPPUNIT_ASSERT_EQUAL(size_t{0}, length);
+  CPPUNIT_ASSERT_EQUAL(std::string("127.0.0.1"), request->getConnectedAddr());
+  CPPUNIT_ASSERT(!manager.isHttpOriginAvailable(*request));
+  CPPUNIT_ASSERT_EQUAL(0, request->getTryCount());
+}
