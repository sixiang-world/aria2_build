+HttpOriginConnection::HttpOriginConnection(
+    RequestGroupMan& manager, std::string origin, a2_gid_t gid, Command* waiter,
+    DownloadEngine* engine)
+    : manager_(manager), origin_(std::move(origin)), gid_(gid), waiter_(waiter),
+      engine_(engine)
+{
+}
+
+HttpOriginConnection::~HttpOriginConnection()
+{
+  manager_.releaseHttpConnection(*this);
+}
+
+HttpOriginConnection* RequestGroupMan::HttpOrigin::nextWaiter() const
+{
+  auto next = std::min_element(
+      waiters.begin(), waiters.end(),
+      [this](const HttpOriginConnection* first,
+             const HttpOriginConnection* next) {
+        const auto& a = groups.at(first->gid_);
+        const auto& b = groups.at(next->gid_);
+        return std::tie(a.active, a.lastTurn) < std::tie(b.active, b.lastTurn);
+      });
+  return next == waiters.end() ? nullptr : *next;
+}
+
+bool HttpOriginConnection::tryAcquire()
+{
+  if (acquired_) {
+    return true;
+  }
+  auto& origin = manager_.httpOrigins_.at(origin_);
+  if (origin.active >= manager_.maxHttpConnectionsPerOrigin_ ||
+      origin.nextWaiter() != this) {
+    return false;
+  }
+
+  auto& group = origin.groups.at(gid_);
+  ++group.active;
+  --group.waiting;
+  group.lastTurn = ++origin.turn;
+  ++origin.active;
+  origin.waiters.erase(
+      std::find(origin.waiters.begin(), origin.waiters.end(), this));
+  waiter_ = nullptr;
+  acquired_ = true;
+  manager_.wakeHttpOriginWaiter(origin);
+  return true;
+}
+
+bool HttpOriginConnection::shouldYield() const
+{
+  const auto& origin = manager_.httpOrigins_.at(origin_);
+  if (origin.active < manager_.maxHttpConnectionsPerOrigin_ ||
+      origin.waiters.empty()) {
+    return false;
+  }
+
+  const auto waiter = origin.nextWaiter();
+  const auto waitingConnections = origin.groups.at(waiter->gid_).active;
+  // A group without a slot must be able to make progress even with a budget
+  // of one. Once both have slots, avoid reconnecting to exchange equal shares.
+  return waiter->gid_ != gid_ &&
+         (waitingConnections == 0 ||
+          origin.groups.at(gid_).active > waitingConnections + 1);
+}
+
+std::shared_ptr<HttpOriginConnection> RequestGroupMan::queueHttpConnection(
+    const Request& request, a2_gid_t gid, Command* waiter,
+    DownloadEngine* engine)
+{
+  if (!isHttpConnectionBudgetEnabled() || request.getHttpOrigin().empty()) {
+    return nullptr;
+  }
+  auto connection = std::shared_ptr<HttpOriginConnection>(
+      new HttpOriginConnection(*this, request.getHttpOrigin(), gid, waiter,
+                               engine));
+  auto& origin = httpOrigins_[request.getHttpOrigin()];
+  auto& group = origin.groups[gid];
+  origin.waiters.push_back(connection.get());
+  ++group.waiting;
+  return connection;
+}
+
+std::shared_ptr<HttpOriginConnection> RequestGroupMan::tryAcquireHttpBackup(
+    const Request& request, a2_gid_t gid, DownloadEngine* engine)
+{
+  const auto origin = httpOrigins_.find(request.getHttpOrigin());
+  if (origin == httpOrigins_.end() || !origin->second.waiters.empty() ||
+      origin->second.active >= maxHttpConnectionsPerOrigin_ ||
+      isHttpHostCoolingDown(request)) {
+    return nullptr;
+  }
+
+  auto connection = std::shared_ptr<HttpOriginConnection>(
+      new HttpOriginConnection(*this, request.getHttpOrigin(), gid, nullptr,
+                               engine));
+  ++origin->second.groups[gid].active;
+  ++origin->second.active;
+  connection->acquired_ = true;
+  return connection;
+}
+
+void RequestGroupMan::releaseHttpConnection(HttpOriginConnection& connection)
+{
+  const auto entry = httpOrigins_.find(connection.origin_);
+  if (entry == httpOrigins_.end()) {
+    return;
+  }
+  auto& origin = entry->second;
+  auto group = origin.groups.find(connection.gid_);
+  if (connection.acquired_) {
+    --group->second.active;
+    --origin.active;
+  }
+  else {
+    auto waiter = std::find(origin.waiters.begin(), origin.waiters.end(),
+                            &connection);
+    if (waiter != origin.waiters.end()) {
+      origin.waiters.erase(waiter);
+      --group->second.waiting;
+    }
+  }
+
+  if (group != origin.groups.end() && group->second.active == 0 &&
+      group->second.waiting == 0) {
+    origin.groups.erase(group);
+  }
+  if (origin.active == 0 && origin.waiters.empty()) {
+    httpOrigins_.erase(entry);
+  }
+  else {
+    wakeHttpOriginWaiter(origin);
+  }
+}
+
+void RequestGroupMan::wakeHttpOriginWaiter(const HttpOrigin& origin)
+{
+  if (origin.active < maxHttpConnectionsPerOrigin_) {
+    auto next = origin.nextWaiter();
+    if (next) {
+      next->waiter_->setStatusActive();
+      next->engine_->setNoWait(true);
+    }
+  }
+}
+
+bool RequestGroupMan::isHttpOriginAvailable(const Request& request) const
+{
+  if (isHttpHostCoolingDown(request)) {
+    return false;
+  }
+  const auto origin = httpOrigins_.find(request.getHttpOrigin());
+  return origin == httpOrigins_.end() ||
+         origin->second.active < maxHttpConnectionsPerOrigin_;
+}
+
+bool RequestGroupMan::isHttpHostCoolingDown(const Request& request) const
+{
+  const auto cooldown = httpCooldowns_.find(request.getHttpHost());
+  return cooldown != httpCooldowns_.end() &&
+         cooldown->second > global::wallclock();
+}
+
+void RequestGroupMan::coolDownHttpHost(const Request& request,
+                                      std::chrono::seconds delay)
+{
+  if (request.getHttpHost().empty() || delay <= std::chrono::seconds::zero()) {
+    return;
+  }
+
+  const auto now = global::wallclock();
+  for (auto it = httpCooldowns_.begin(); it != httpCooldowns_.end();) {
+    if (it->second <= now) {
+      it = httpCooldowns_.erase(it);
+    }
+    else {
+      ++it;
+    }
+  }
+  auto deadline = now;
+  deadline.advance(delay);
+  auto& current = httpCooldowns_[request.getHttpHost()];
+  current = std::max(current, deadline);
+}
