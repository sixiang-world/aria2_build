+  auto active = manager.queueHttpConnection(request, 1, &one, e_.get());
+  CPPUNIT_ASSERT(active->tryAcquire());
+  auto sameGroup = manager.queueHttpConnection(request, 1, &two, e_.get());
+  CPPUNIT_ASSERT(!active->shouldYield());
+  auto canceled = manager.queueHttpConnection(request, 2, &three, e_.get());
+  auto waiting = manager.queueHttpConnection(request, 3, &four, e_.get());
+  CPPUNIT_ASSERT(active->shouldYield());
+
+  active.reset();
+  CPPUNIT_ASSERT(!waiting->tryAcquire());
+  canceled.reset();
+  // The original group had its turn. Canceling the next waiter admits the
+  // other group even though it queued after the original group's second slot.
+  CPPUNIT_ASSERT(!sameGroup->tryAcquire());
+  CPPUNIT_ASSERT(waiting->tryAcquire());
+  CPPUNIT_ASSERT(waiting->shouldYield());
+  waiting.reset();
+  CPPUNIT_ASSERT(sameGroup->tryAcquire());
+}
