+HttpResumeInfo DefaultBtProgressInfoFile::readHttpResumeInfo(BufferedFile& fp)
+{
+  uint16_t lengthNL;
+  if (fp.seek(-static_cast<long>(sizeof(lengthNL)), SEEK_END) != 0) {
+    throw DL_ABORT_EX(fmt(EX_SEGMENT_FILE_READ, filename_.c_str()));
+  }
+  READ_CHECK(fp, &lengthNL, sizeof(lengthNL));
+
+  const auto length = ntohs(lengthNL);
+  if (length < 2 || length > HttpResumeInfo::MAX_VALIDATOR_LENGTH ||
+      fp.seek(-static_cast<long>(sizeof(lengthNL) + length +
+                                 HttpResumeInfo::RESOURCE_LENGTH),
+              SEEK_END) != 0) {
+    throw DL_ABORT_EX(fmt(EX_SEGMENT_FILE_READ, filename_.c_str()));
+  }
+
+  HttpResumeInfo info{std::string(HttpResumeInfo::RESOURCE_LENGTH, '\0'),
+                      std::string(length, '\0')};
+  READ_CHECK(fp, &info.resource[0], info.resource.size());
+  READ_CHECK(fp, &info.validator[0], info.validator.size());
+  if (!info.valid()) {
+    throw DL_ABORT_EX(fmt(EX_SEGMENT_FILE_READ, filename_.c_str()));
+  }
+  return info;
+}
+
+HttpResumeInfo
+DefaultBtProgressInfoFile::readHttpResumeInfo(uint64_t& savedLength)
+{
+  BufferedFile fp(filename_.c_str(), BufferedFile::READ);
+  if (!fp) {
+    throw DL_ABORT_EX(fmt(EX_SEGMENT_FILE_READ, filename_.c_str()));
+  }
+
+  unsigned char header[6];
+  READ_CHECK(fp, header, sizeof(header));
+  if (header[0] != 0 || header[1] != 1 ||
+      !(header[5] & HTTP_RESUME_EXTENSION) || (header[5] & 1)) {
+    return {};
+  }
+
+  uint32_t infoHashLength;
+  READ_CHECK(fp, &infoHashLength, sizeof(infoHashLength));
+  uint32_t pieceLength;
+  READ_CHECK(fp, &pieceLength, sizeof(pieceLength));
+  if (infoHashLength != 0 || pieceLength == 0) {
+    throw DL_ABORT_EX(fmt(EX_SEGMENT_FILE_READ, filename_.c_str()));
+  }
+  READ_CHECK(fp, &savedLength, sizeof(savedLength));
+  savedLength = ntoh64(savedLength);
+  return readHttpResumeInfo(fp);
+}
+
