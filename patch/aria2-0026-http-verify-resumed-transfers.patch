   if (fp_) {
-    fflush(fp_);
+    const auto flushResult = fflush(fp_);
 #ifndef __MINGW32__
-    fsync(fileno(fp_));
+    const auto syncResult = fsync(fileno(fp_));
 #else  // __MINGW32__
